# Use the Supabase Direct Connection string for persistent hosts with IPv6.
# For IPv4-only hosts, use Supabase's Session Pooler connection string instead.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# API keys and frontend URL.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
FRONTEND_BASE_URL=http://localhost:5173

# Business time zone and local runtime settings file (not stored in PostgreSQL).
APP_TIMEZONE=Asia/Ho_Chi_Minh
RUNTIME_SETTINGS_PATH=.runtime/shop-settings.json

# Initial owner bootstrap values; live login reads the bcrypt hash in chu_quan.
OWNER_USERNAME=
OWNER_PASSWORD=

# Supabase Storage settings (keep the service role key backend-only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=menu-images

# Used to create the static VietQR preview; automatic bank payment matching is deferred.
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
